<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        xmlns:ex="clr-namespace:Cirq.Components.Explaining;assembly=Cirq.Components"
        x:Class="Cirq.UI.Views.ExplainWindow"
        x:DataType="vm:ExplainViewModel"
        Title="What This Circuit Is"
        Width="680" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <DockPanel Margin="14">


    <!-- A way out that does not depend on a title bar, because a tiling window manager draws
         none. Escape closes it too; this is the half somebody can see. -->
    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <Button Name="CloseButton" Content="Close" MinWidth="88" Padding="14,5"
              HorizontalAlignment="Right" />
    </Border>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap"
               FontSize="13" Margin="0,0,0,12" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
      <Button Content="Copy all" Command="{Binding CopyCommand}" IsEnabled="{Binding HasAny}"
              Padding="14,5" />
      <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                 Text="Pick one to light its parts up on the drawing." />
    </StackPanel>

    <ListBox ItemsSource="{Binding Found}" SelectedItem="{Binding Selected, Mode=TwoWay}"
             Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="ex:Explanation">
          <StackPanel Spacing="2" Margin="0,5">
            <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Detail}" Opacity="0.75" TextWrapping="Wrap" FontSize="12" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</Window>
