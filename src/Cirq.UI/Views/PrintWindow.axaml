<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        xmlns:svc="clr-namespace:Cirq.UI.Services"
        x:Class="Cirq.UI.Views.PrintWindow"
        x:DataType="vm:PrintViewModel"
        Title="Print"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <StackPanel Margin="20" Spacing="16">

    <StackPanel Spacing="4">
      <TextBlock Text="WHAT TO PRINT" FontSize="10" Opacity="0.55" />
      <CheckBox Content="Schematic" IsChecked="{Binding IncludeSchematic}" />
      <CheckBox Content="Oscilloscope traces" IsChecked="{Binding IncludeTraces}"
                IsEnabled="{Binding HasTraces}" />
      <CheckBox Content="Parts list" IsChecked="{Binding IncludePartsList}" />
      <TextBlock Text="Each gets a sheet of its own." FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="PAPER" FontSize="10" Opacity="0.55" />
      <ComboBox HorizontalAlignment="Stretch" SelectedItem="{Binding Paper}"
                ItemsSource="{Binding Source={x:Static vm:PrintViewModel.PaperOptions}}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static svc:PaperDescription.Instance}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <ComboBox HorizontalAlignment="Stretch" SelectedItem="{Binding Orientation}"
                ItemsSource="{Binding Source={x:Static vm:PrintViewModel.OrientationOptions}}" />
    </StackPanel>

    <StackPanel Spacing="4">
      <CheckBox Content="Fit to the page" IsChecked="{Binding FitToPage}"
                ToolTip.Tip="Scales a large schematic down so it fits. Turned off, it prints at its natural size and may run off the sheet." />
      <CheckBox Content="Title block across the top of every sheet" IsChecked="{Binding IncludeHeader}"
                ToolTip.Tip="What the drawing is, which sheet this is, the revision, who drew it, the date and the page number" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IncludeHeader}">
      <TextBlock Text="Rev" VerticalAlignment="Center" Opacity="0.7" Width="30" />
      <TextBox Width="70" AutomationProperties.Name="The revision this drawing is at"
               Text="{Binding Revision, Mode=TwoWay}" />
      <TextBlock Text="Drawn by" VerticalAlignment="Center" Opacity="0.7" />
      <TextBox Width="150" AutomationProperties.Name="Who drew this"
               Text="{Binding Author, Mode=TwoWay}" />
    </StackPanel>

    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Name="Cancel" Content="Cancel" MinWidth="88" IsCancel="True" />
      <Button Name="Ok" Content="Print" MinWidth="96" IsDefault="True"
              IsEnabled="{Binding HasSomethingToPrint}" />
    </StackPanel>

  </StackPanel>
</Window>
