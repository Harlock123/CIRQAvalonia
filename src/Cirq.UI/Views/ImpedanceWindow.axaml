<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        x:Class="Cirq.UI.Views.ImpedanceWindow"
        x:DataType="vm:ImpedanceViewModel"
        Title="Impedance"
        Width="960" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <DockPanel>


    <!-- A way out that does not depend on a title bar, because a tiling window manager draws
         none. Escape closes it too; this is the half somebody can see. -->
    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <Button Name="CloseButton" Content="Close" MinWidth="88" Padding="14,5"
              HorizontalAlignment="Right" />
    </Border>
    <Border DockPanel.Dock="Top" Padding="14,12"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Look into" VerticalAlignment="Center" />
        <ComboBox AutomationProperties.Name="Point to measure the impedance at" Width="160" ItemsSource="{Binding Probes}"
                  SelectedItem="{Binding Probe, Mode=TwoWay}"
                  DisplayMemberBinding="{Binding Label}"
                  ToolTip.Tip="The point to measure the impedance of. A probe with a reference is measured between its two points; one without is measured against ground." />

        <TextBlock Text="from" VerticalAlignment="Center" Opacity="0.7" />
        <TextBox AutomationProperties.Name="Sweep from, in hertz" Width="80" Text="{Binding StartHz, Mode=TwoWay}" />
        <TextBlock Text="to" VerticalAlignment="Center" Opacity="0.7" />
        <TextBox AutomationProperties.Name="Sweep to, in hertz" Width="80" Text="{Binding StopHz, Mode=TwoWay}" />
        <TextBlock Text="Hz" VerticalAlignment="Center" Opacity="0.7" />

        <Button Content="Measure" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}"
                Padding="18,5" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="14,10"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="26">
          <StackPanel>
            <TextBlock Text="LOW FREQUENCY" FontSize="10" Opacity="0.5" />
            <TextBlock Text="{Binding LowFrequency}" FontSize="19" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="LOWEST" FontSize="10" Opacity="0.5" />
            <TextBlock Text="{Binding Minimum}" FontSize="19" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="HIGHEST" FontSize="10" Opacity="0.5" />
            <TextBlock Text="{Binding Maximum}" FontSize="19" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" VerticalAlignment="Center"
                     MaxWidth="420" Opacity="0.85" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.6" FontSize="11" />
          <TextBlock Text="{Binding Readout}" FontSize="11" FontFamily="monospace"
                     Foreground="{DynamicResource NetHighlight}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <sp:AvaPlot Name="Plot" />

  </DockPanel>
</Window>
