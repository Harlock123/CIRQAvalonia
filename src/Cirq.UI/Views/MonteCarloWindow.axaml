<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        x:Class="Cirq.UI.Views.MonteCarloWindow"
        x:DataType="vm:MonteCarloViewModel"
        Title="Tolerance Analysis"
        Width="900" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <DockPanel>


    <!-- A way out that does not depend on a title bar, because a tiling window manager draws
         none. Escape closes it too; this is the half somebody can see. -->
    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <Button Name="CloseButton" Content="Close" MinWidth="88" Padding="14,5"
              HorizontalAlignment="Right" />
    </Border>
    <Border DockPanel.Dock="Top" Padding="14,12"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Trials" VerticalAlignment="Center" />
          <TextBox AutomationProperties.Name="Number of builds" Width="74" Text="{Binding Trials, Mode=TwoWay}"
                   ToolTip.Tip="How many circuits to build and solve. A few hundred is enough to see the shape; a few thousand to see the corners." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Seed" VerticalAlignment="Center" />
          <TextBox AutomationProperties.Name="Random seed" Width="60" Text="{Binding Seed, Mode=TwoWay}"
                   ToolTip.Tip="The same seed gives exactly the same run. Change it for a different draw of the same parts." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Accept within ±" VerticalAlignment="Center" />
          <TextBox AutomationProperties.Name="Acceptable band, as a percentage" Width="52" Text="{Binding AcceptableBandPercent, Mode=TwoWay}" />
          <TextBlock Text="% of nominal" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <Button Content="Run" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}"
                Padding="20,5" />

        <Button Content="Worst case" Command="{Binding FindCornersCommand}" Padding="14,5"
                ToolTip.Tip="The worst this circuit can ever be, rather than the worst these trials happened to be. Random sampling essentially never lands on the corner where every part is at its extreme the same way — that is one combination out of two to the number of parts." />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.85" />

        <TextBlock Text="{Binding CornerSummary}" TextWrapping="Wrap" Opacity="0.85"
                   IsVisible="{Binding CornerSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <ItemsControl ItemsSource="{Binding Corners}" IsVisible="{Binding HasCorners}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontSize="11" Opacity="0.75" FontFamily="monospace" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Varied}" IsVisible="{Binding HasRows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,6,0" Padding="6,1" CornerRadius="3"
                      Background="{DynamicResource GroupHeaderBackground}">
                <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource TextMuted}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Grid RowDefinitions="Auto,*">

      <Border Grid.Row="0" Padding="14,10" IsVisible="{Binding HasRows}">
        <StackPanel>
          <Grid ColumnDefinitions="140,110,150,100,90,80" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="TRACE" FontSize="10" Opacity="0.55" />
            <TextBlock Grid.Column="1" Text="NOMINAL" FontSize="10" Opacity="0.55" />
            <TextBlock Grid.Column="2" Text="RANGE" FontSize="10" Opacity="0.55" />
            <TextBlock Grid.Column="3" Text="σ" FontSize="10" Opacity="0.55" />
            <TextBlock Grid.Column="4" Text="WORST" FontSize="10" Opacity="0.55" />
            <TextBlock Grid.Column="5" Text="IN SPEC" FontSize="10" Opacity="0.55" />
          </Grid>

          <ListBox AutomationProperties.Name="Results, one per measurement" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                   Background="Transparent" MaxHeight="150">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="140,110,150,100,90,80">
                  <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Nominal}" FontSize="12" />
                  <TextBlock Grid.Column="2" Text="{Binding Range}" FontSize="12" />
                  <TextBlock Grid.Column="3" Text="{Binding Sigma}" FontSize="12" Opacity="0.8" />
                  <TextBlock Grid.Column="4" Text="{Binding Worst}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="5" Text="{Binding Yield}" FontSize="12" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="*,270">

        <sp:AvaPlot Grid.Column="0" Name="Plot" />

        <!-- Which part is responsible, for whichever trace is selected above. -->
        <Border Grid.Column="1" Classes="panel" BorderThickness="1,0,0,0" Padding="10,8"
                IsVisible="{Binding HasSensitivity}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="WHERE THE SPREAD COMES FROM"
                       FontSize="10" Opacity="0.55" Margin="0,0,0,2" />
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                       Margin="0,0,0,8"
                       Text="Each part taken to both ends of its own band with everything else at nominal. Share is of the variance, so contributions add in quadrature." />

            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Sensitivity}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,7">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Part}" FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Share}" FontSize="12" />
                      </Grid>

                      <ProgressBar Minimum="0" Maximum="1" Value="{Binding Weight}"
                                   Height="4" Margin="0,2,0,2" />

                      <TextBlock FontSize="10" Opacity="0.65"
                                 Text="{Binding Tolerance, StringFormat='band {0}'}" />
                      <TextBlock FontSize="10" Opacity="0.65"
                                 Text="{Binding Elasticity, StringFormat='output moves {0}x as far, proportionally'}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

  </DockPanel>
</Window>
