<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        x:Class="Cirq.UI.Views.SpecSweepWindow"
        x:DataType="vm:SpecSweepViewModel"
        Title="Requirements Over a Range"
        Width="960" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <DockPanel>

    <!-- A way out that does not depend on a title bar, because a tiling window manager draws
         none. Escape closes it too; this is the half somebody can see. -->
    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <Button Name="CloseButton" Content="Close" MinWidth="88" Padding="14,5"
              HorizontalAlignment="Right" />
    </Border>

    <!-- What to vary, over what range, and how long to run at each point. -->
    <Border DockPanel.Dock="Top" Padding="14,12"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="10">

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="Over" VerticalAlignment="Center" Width="56" />
          <ComboBox AutomationProperties.Name="What to vary" Width="230"
                    ItemsSource="{Binding Options}" SelectedItem="{Binding Parameter, Mode=TwoWay}"
                    ToolTip.Tip="The temperature, or any part's value. Temperature is the range almost every design is specified over, and the only one that moves every part at once." />

          <TextBlock Text="from" VerticalAlignment="Center" Opacity="0.7" />
          <TextBox AutomationProperties.Name="From" Width="96" Text="{Binding Start, Mode=TwoWay}" />
          <TextBlock Text="to" VerticalAlignment="Center" Opacity="0.7" />
          <TextBox AutomationProperties.Name="To" Width="96" Text="{Binding Stop, Mode=TwoWay}" />

          <TextBlock Text="in" VerticalAlignment="Center" Opacity="0.7" />
          <ComboBox AutomationProperties.Name="How many points" Width="70"
                    SelectedItem="{Binding Count, Mode=TwoWay}"
                    ItemsSource="{Binding Source={x:Static vm:SpecSweepViewModel.CountOptions}}" />
          <TextBlock Text="points" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="Each for" VerticalAlignment="Center" Width="56" />
          <TextBox AutomationProperties.Name="How long to run at each point, in seconds" Width="120"
                   Text="{Binding Duration, Mode=TwoWay}"
                   ToolTip.Tip="Long enough for the circuit to reach whatever the requirement is about — a ripple figure needs several cycles of it." />
          <TextBlock Text="seconds" VerticalAlignment="Center" Opacity="0.7" />

          <Button Content="Run" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}"
                  Padding="18,5" />

          <TextBlock VerticalAlignment="Center" Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                     Text="Every requirement is checked at every point, by the same code that checks them in the Requirements window." />
        </StackPanel>

      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.85" />
    </Border>

    <!-- The verdicts below the plot: the picture says where, the list says what. -->
    <Border DockPanel.Dock="Bottom" MinHeight="150" MaxHeight="260" Padding="8,6"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <ListBox AutomationProperties.Name="What each requirement did across the range"
               ItemsSource="{Binding Rows}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SpecMarginRow">
            <Grid ColumnDefinitions="76,150,*" Margin="0,3">
              <Border Grid.Column="0" CornerRadius="3" Padding="6,1" Height="20"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Background="{DynamicResource GroupHeaderBackground}">
                <TextBlock Text="{Binding Status}" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" />
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Margin="0,2,8,0"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
              <StackPanel Grid.Column="2" Spacing="1">
                <TextBlock Text="{Binding Requirement}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <sp:AvaPlot Name="Plot" />

  </DockPanel>
</Window>
