<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
             x:Class="Cirq.UI.Views.ScopePanel"
             x:DataType="vm:ScopeViewModel">

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,190">

    <!-- Scope controls -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="panel" BorderThickness="0,0,0,1" Padding="8,5">
      <!-- Two groups inside a WrapPanel rather than one long row: the full set of controls is
           wider than the window even at fullscreen, and a plain StackPanel silently clipped the
           right-hand end instead of giving way. -->
      <WrapPanel Orientation="Horizontal">
      <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
        <TextBlock Classes="label" Text="Timebase" VerticalAlignment="Center" />
        <Button Classes="toolbar" Content="&#x2212;" Command="{Binding ZoomTimeOutCommand}"
                ToolTip.Tip="Slower timebase (more seconds per division)" />
        <TextBlock Classes="value" Width="80" TextAlignment="Center"
                   Text="{Binding TimebaseLabel}" />
        <Button Classes="toolbar" Content="+" Command="{Binding ZoomTimeInCommand}"
                ToolTip.Tip="Faster timebase" />

        <Separator Classes="vertical" />

        <TextBlock Classes="label" Text="Vertical" VerticalAlignment="Center" />
        <Button Classes="toolbar" Content="&#x2212;" Command="{Binding ZoomVoltsOutCommand}" />
        <TextBlock Classes="value" Width="80" TextAlignment="Center" Text="{Binding VoltsLabel}" />
        <Button Classes="toolbar" Content="+" Command="{Binding ZoomVoltsInCommand}" />
        <CheckBox FontSize="12" Content="Auto" IsChecked="{Binding AutoScaleVertical}"
                  ToolTip.Tip="Keep the vertical range fitted to the traces. Using the +/- buttons turns this off." />

      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Classes="label" Text="Layout" VerticalAlignment="Center" />
        <ComboBox FontSize="12" MinWidth="100" SelectedItem="{Binding Layout}"
                  ItemsSource="{Binding Source={x:Static vm:ScopeViewModel.LayoutOptions}}" />

        <!-- Only in XY, where the horizontal axis is a signal and has to be chosen. -->
        <TextBlock Classes="label" Text="X axis" VerticalAlignment="Center"
                   IsVisible="{Binding IsXy}" />
        <ComboBox FontSize="12" MinWidth="110" IsVisible="{Binding IsXy}"
                  ItemsSource="{Binding Probes}" DisplayMemberBinding="{Binding Label}"
                  SelectedItem="{Binding XyHorizontal, Mode=TwoWay}"
                  ToolTip.Tip="Which trace goes along the bottom. Everything else is drawn against it." />

        <Separator Classes="vertical" />

        <CheckBox FontSize="12" Content="AC couple" IsChecked="{Binding AcCoupleAll}"
                  ToolTip.Tip="Subtract each trace's DC average before display" />
        <CheckBox FontSize="12" Content="Auto-scroll" IsChecked="{Binding AutoScroll}" />

        <Separator Classes="vertical" />

        <TextBlock Classes="label" Text="Trigger" VerticalAlignment="Center" />
        <ComboBox FontSize="12" MinWidth="86" AutomationProperties.Name="When the capture starts"
                  ItemsSource="{Binding Source={x:Static vm:ScopeViewModel.TriggerModes}}"
                  SelectedItem="{Binding TriggerMode, Mode=TwoWay}"
                  ToolTip.Tip="Off follows the newest samples. Auto and Normal line an edge up in the same place every repaint, so a repeating waveform stands still. Single catches one edge and stops." />

        <ComboBox FontSize="12" MinWidth="96" IsVisible="{Binding IsTriggering}"
                  AutomationProperties.Name="Which trace to trigger on"
                  ItemsSource="{Binding Probes}" DisplayMemberBinding="{Binding Label}"
                  SelectedItem="{Binding TriggerProbe, Mode=TwoWay}"
                  ToolTip.Tip="Which trace the edge is looked for on. The first visible one until you choose." />

        <ComboBox FontSize="12" MinWidth="76" IsVisible="{Binding IsTriggering}"
                  AutomationProperties.Name="Which way the signal has to be going"
                  ItemsSource="{Binding Source={x:Static vm:ScopeViewModel.TriggerSlopes}}"
                  SelectedItem="{Binding TriggerSlope, Mode=TwoWay}" />

        <TextBox Width="64" FontSize="11" Padding="6,3" MinHeight="0"
                 IsVisible="{Binding IsTriggering}"
                 AutomationProperties.Name="The level to trigger at"
                 Text="{Binding TriggerLevel, Mode=TwoWay}"
                 ToolTip.Tip="The value the signal has to cross, in the trace's own units" />

        <Button Classes="toolbar" Content="Arm" Command="{Binding ArmCommand}"
                IsVisible="{Binding IsSingleShot}"
                ToolTip.Tip="Wait for the next edge, catch it, and stop" />

        <TextBlock Classes="label" VerticalAlignment="Center" MaxWidth="200"
                   IsVisible="{Binding IsTriggering}" TextTrimming="CharacterEllipsis"
                   Text="{Binding TriggerStatus}" />

        <Separator Classes="vertical" />

        <CheckBox FontSize="12" Content="Measure" IsChecked="{Binding ShowMeasurements}"
                  ToolTip.Tip="Show what each trace is doing — peak to peak, frequency, and the rest on the row's tooltip" />
        <CheckBox FontSize="12" Content="Cursors" IsChecked="{Binding ShowCursors}"
                  ToolTip.Tip="Two draggable time cursors, with the gap between them and what each trace does there" />

        <Separator Classes="vertical" />

        <TextBox Width="150" FontSize="11" Padding="6,3" MinHeight="0"
                 Text="{Binding ExpressionText, Mode=TwoWay}"
                 PlaceholderText="Out / In"
                 ToolTip.Tip="Arithmetic on the recorded traces: a ratio, a difference, a power. Use + - * / ^, brackets, and abs sqrt log log10 db exp sin cos sign. A label with spaces in it goes in braces: {DC out} - {AC in}.">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AddComputedCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Classes="toolbar" Content="Add trace" Command="{Binding AddComputedCommand}" />

        <TextBlock Classes="label" VerticalAlignment="Center" MaxWidth="260"
                   TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding HasExpressionProblem}"
                   Foreground="{DynamicResource TextError}"
                   Text="{Binding ExpressionProblem}" />

        <Separator Classes="vertical" />

        <Button Classes="toolbar" Content="Keep as reference" Command="{Binding CaptureReferenceCommand}"
                ToolTip.Tip="Take a copy of what is on screen now. It stays drawn, dashed and faded, while you change the circuit — so you can see whether what you did helped." />
        <Button Classes="toolbar" Content="{Binding ReferenceSummary}"
                IsVisible="{Binding HasReferences}"
                Command="{Binding ClearReferencesCommand}"
                ToolTip.Tip="Throw the kept traces away" />

        <Separator Classes="vertical" />

        <Button Classes="toolbar" Content="Clear traces" Command="{Binding ClearTracesCommand}" />
      </StackPanel>
      </WrapPanel>
    </Border>

    <!-- Plot surface -->
    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource PlotBackground}">
      <Grid>
        <sp:AvaPlot Name="Plot" />
        <TextBlock Name="EmptyHint" Classes="label"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Pick the Probe tool and click a terminal to add a trace"
                   IsVisible="False" />
      </Grid>
    </Border>

    <!-- Trace list -->
    <Border Grid.Row="1" Grid.Column="1" Classes="panel" BorderThickness="1,0,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="heading" Text="TRACES" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Probes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="6,2" Padding="6,4" CornerRadius="4" Background="{DynamicResource GroupHeaderBackground}">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <CheckBox Grid.Row="0" Grid.Column="0" MinWidth="0" Margin="0,0,4,0"
                              IsChecked="{Binding IsVisible}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" FontSize="12"
                               Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="0" Grid.Column="2" Content="&#x2715;" FontSize="10"
                            Padding="5,1" Background="Transparent"
                            Command="{Binding $parent[ItemsControl].((vm:ScopeViewModel)DataContext).RemoveProbeCommand}"
                            CommandParameter="{Binding}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                Orientation="Horizontal" Spacing="6">
                      <ComboBox FontSize="10" MinHeight="0" Padding="4,0" VerticalAlignment="Center"
                                ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}"
                                ToolTip.Tip="What this probe measures at that terminal" />
                      <TextBlock FontSize="11" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextMuted}" Text="{Binding Reading}" />
                      <!-- Only for the kinds measured between two points, where it is the half of
                           the measurement the label does not name. -->
                      <TextBlock FontSize="10" VerticalAlignment="Center" IsVisible="{Binding IsDerived}"
                                 Foreground="{DynamicResource TextMuted}"
                                 Text="{Binding ReferenceLabel, StringFormat='vs {0}'}"
                                 ToolTip.Tip="Shift-click a terminal with the probe tool to change this; shift-click it again to go back to ground."
                                 TextTrimming="CharacterEllipsis" MaxWidth="90" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                               FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextMuted}"
                               Text="{Binding Summary}"
                               ToolTip.Tip="{Binding SummaryDetail}"
                               IsVisible="{Binding $parent[ItemsControl].((vm:ScopeViewModel)DataContext).ShowMeasurements}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- The cursor strip. Only there while the cursors are, since an empty bar across the bottom
         of the scope costs height the traces would rather have. -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="panel" BorderThickness="0,1,0,0"
            Padding="8,4" IsVisible="{Binding ShowCursors}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="value" FontSize="11" VerticalAlignment="Center"
                   Text="{Binding CursorReadout}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
