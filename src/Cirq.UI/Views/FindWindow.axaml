<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        xmlns:svc="clr-namespace:Cirq.UI.Services"
        x:Class="Cirq.UI.Views.FindWindow"
        x:DataType="vm:FindViewModel"
        Title="Find on Sheet"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <DockPanel Margin="14">

    <TextBox DockPanel.Dock="Top" Name="Term" Text="{Binding Term, Mode=TwoWay}"
             PlaceholderText="R17, 4k7, Resistor, VCC…" FontSize="15" Padding="8,6" />

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Opacity="0.6"
               FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap" />

    <ListBox Name="Results" Margin="0,10,0,0"
             ItemsSource="{Binding Matches}"
             SelectedItem="{Binding Selected, Mode=TwoWay}"
             Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="svc:SheetMatch">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,2">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Width="90"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Detail}" Opacity="0.65"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</Window>
