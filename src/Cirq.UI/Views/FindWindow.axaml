<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        xmlns:svc="clr-namespace:Cirq.UI.Services"
        x:Class="Cirq.UI.Views.FindWindow"
        x:DataType="vm:FindViewModel"
        Title="Find and Change"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <DockPanel Margin="14">

    <TextBox AutomationProperties.Name="What to find on the sheet" DockPanel.Dock="Top" Name="Term" Text="{Binding Term, Mode=TwoWay}"
             PlaceholderText="R17, 4k7, Resistor, VCC…" FontSize="15" Padding="8,6" />

    <!-- Changing what was found. Hidden until there is something to change, because a row of
         boxes that cannot do anything is a row of boxes somebody has to work out is inert. -->
    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,9" CornerRadius="4"
            IsVisible="{Binding CanEdit}"
            Background="{DynamicResource GroupHeaderBackground}">
      <StackPanel Spacing="7">

        <StackPanel Orientation="Horizontal" Spacing="7">
          <TextBlock Text="Change" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
          <ComboBox Width="150" AutomationProperties.Name="Which setting to change"
                    ItemsSource="{Binding Properties}"
                    SelectedItem="{Binding Property, Mode=TwoWay}" />
          <TextBlock Text="to" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
          <TextBox Width="110" AutomationProperties.Name="The value or expression to use"
                   Text="{Binding Replacement, Mode=TwoWay}" PlaceholderText="12k, or Rf / 4" />
          <Button Content="Set" Command="{Binding ReplaceCommand}" Padding="12,4" />
          <Button Content="Bind" Command="{Binding BindCommand}" Padding="12,4"
                  ToolTip.Tip="Point them at a parameter, or at arithmetic over the parameters" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="7">
          <TextBlock Text="Or name what they share:" VerticalAlignment="Center" Opacity="0.7"
                     FontSize="12" />
          <TextBox Width="110" AutomationProperties.Name="A name for the value they share"
                   Text="{Binding ParameterName, Mode=TwoWay}" PlaceholderText="Rf" />
          <Button Content="Make a parameter" Command="{Binding ExtractCommand}" Padding="12,4"
                  ToolTip.Tip="Take the value these all have, give it that name, and bind them to it" />
        </StackPanel>

        <TextBlock Text="{Binding EditSummary}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />

      </StackPanel>
    </Border>

    <!-- Escape closes it and Enter goes to the top match; this is the half somebody can see,
         which matters on a desktop that draws no title bar. -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="2,8,0,0">
      <TextBlock Text="{Binding Summary}" Opacity="0.6" FontSize="11"
                 TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Name="CloseButton" Content="Close" MinWidth="88" Padding="14,5" />
    </Grid>

    <ListBox AutomationProperties.Name="What was found" Name="Results" Margin="0,10,0,0"
             ItemsSource="{Binding Matches}"
             SelectedItem="{Binding Selected, Mode=TwoWay}"
             Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="svc:SheetMatch">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,2">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Width="90"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Detail}" Opacity="0.65"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</Window>
