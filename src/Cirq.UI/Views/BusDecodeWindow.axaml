<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        x:Class="Cirq.UI.Views.BusDecodeWindow"
        x:DataType="vm:BusDecodeViewModel"
        Title="Decode Bus"
        Width="880" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <DockPanel>


    <!-- A way out that does not depend on a title bar, because a tiling window manager draws
         none. Escape closes it too; this is the half somebody can see. -->
    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <Button Name="CloseButton" Content="Close" MinWidth="88" Padding="14,5"
              HorizontalAlignment="Right" />
    </Border>
    <Border DockPanel.Dock="Top" Padding="14,12"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="10">

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="Read as" VerticalAlignment="Center" />
          <ComboBox Width="110" SelectedItem="{Binding Protocol, Mode=TwoWay}"
                    ItemsSource="{Binding Source={x:Static vm:BusDecodeViewModel.ProtocolOptions}}" />

          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding NeedsBitRate}">
            <TextBlock Text="Bit rate" VerticalAlignment="Center" Opacity="0.7" />
            <TextBox Width="90" Text="{Binding BitRate, Mode=TwoWay}"
                     ToolTip.Tip="Neither UART nor CAN carries a clock, so both ends have to have been told the rate — and a wrong one decodes into plausible rubbish rather than into nothing." />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding NeedsMode}">
            <TextBlock Text="Mode" VerticalAlignment="Center" Opacity="0.7" />
            <TextBox Width="42" Text="{Binding SpiMode, Mode=TwoWay}"
                     ToolTip.Tip="Which clock edge samples the data. Getting it wrong shifts every byte by a bit and looks completely right on the scope." />
          </StackPanel>

          <Button Content="Decode" Command="{Binding RunCommand}" Padding="18,5" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding LabelA}" Width="44" VerticalAlignment="Center" Opacity="0.7" />
          <ComboBox Width="150" ItemsSource="{Binding Traces}" DisplayMemberBinding="{Binding Label}"
                    SelectedItem="{Binding ChannelA, Mode=TwoWay}" />

          <TextBlock Text="{Binding LabelB}" Width="44" VerticalAlignment="Center" Opacity="0.7"
                     IsVisible="{Binding UsesB}" />
          <ComboBox Width="150" ItemsSource="{Binding Traces}" DisplayMemberBinding="{Binding Label}"
                    SelectedItem="{Binding ChannelB, Mode=TwoWay}" IsVisible="{Binding UsesB}" />

          <TextBlock Text="{Binding LabelC}" Width="44" VerticalAlignment="Center" Opacity="0.7"
                     IsVisible="{Binding UsesC}" />
          <ComboBox Width="150" ItemsSource="{Binding Traces}" DisplayMemberBinding="{Binding Label}"
                    SelectedItem="{Binding ChannelC, Mode=TwoWay}" IsVisible="{Binding UsesC}" />

          <TextBlock Text="{Binding LabelD}" Width="44" VerticalAlignment="Center" Opacity="0.7"
                     IsVisible="{Binding UsesD}" />
          <ComboBox Width="150" ItemsSource="{Binding Traces}" DisplayMemberBinding="{Binding Label}"
                    SelectedItem="{Binding ChannelD, Mode=TwoWay}" IsVisible="{Binding UsesD}" />
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- The transcript, which is the answer most of the time: the whole conversation on one line. -->
    <Border DockPanel.Dock="Top" Padding="14,8"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1"
            IsVisible="{Binding HasRows}">
      <SelectableTextBlock Text="{Binding Transcript}" TextWrapping="Wrap"
                           FontFamily="monospace" FontSize="12" />
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.85" />
    </Border>

    <ListBox ItemsSource="{Binding Rows}" Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="88,82,96,*" Margin="0,2">
            <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="11" Opacity="0.6"
                       VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="11" Opacity="0.6"
                       VerticalAlignment="Top" />
            <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12" FontWeight="SemiBold"
                       VerticalAlignment="Top" Margin="0,0,8,0" />
            <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                       Opacity="0.85" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</Window>
