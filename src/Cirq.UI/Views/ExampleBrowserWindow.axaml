<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        x:Class="Cirq.UI.Views.ExampleBrowserWindow"
        x:DataType="vm:ExampleBrowserViewModel"
        Title="Example Circuits"
        Width="820" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <DockPanel Margin="0">

    <!-- Search across names, descriptions and group names, because people look for "I2C" as
         often as for the name of a circuit they half remember. -->
    <Border DockPanel.Dock="Top" Padding="14,12"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
      <TextBox AutomationProperties.Name="Search the examples" Name="SearchBox" PlaceholderText="Search examples..."
               Text="{Binding Search, Mode=TwoWay}" />
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="14,10"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextMuted}" />
        <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}"
                Padding="18,5" Margin="0,0,8,0" IsCancel="True" />
        <Button Grid.Column="2" Content="Open" Command="{Binding OpenCommand}"
                Padding="22,5" IsDefault="True" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="300,1,*">

      <ScrollViewer Grid.Column="0" Padding="8,8,4,8">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ExampleGroupViewModel">
                <StackPanel>
                  <!-- Named from the data, because the content is a layout rather than a word: a screen
                       reader reading this row would otherwise announce a chevron, a name and a
                       count as three unrelated pieces of text. -->
                  <ToggleButton Classes="groupHeader" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                AutomationProperties.Name="{Binding Name}">
                    <Grid ColumnDefinitions="14,*,Auto">
                      <TextBlock Text="{Binding Chevron}" FontSize="9"
                                 Foreground="{DynamicResource TextMuted}"
                                 VerticalAlignment="Center" HorizontalAlignment="Left" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11"
                                 FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="10"
                                 Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                    </Grid>
                  </ToggleButton>

                  <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}"
                                Margin="0,1,0,4">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ExampleRowViewModel">
                        <!-- A radio-styled toggle rather than a button, so the row that is being
                             described is visibly the one that is selected. -->
                        <ToggleButton Classes="exampleRow" IsChecked="{Binding IsSelected}"
                                      Content="{Binding Name}"
                                      ToolTip.Tip="{Binding Description}"
                                      Command="{Binding $parent[Window].((vm:ExampleBrowserViewModel)DataContext).SelectCommand}"
                                      CommandParameter="{Binding}"
                                      DoubleTapped="OnRowDoubleTapped" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Nothing matches that." Margin="14,20,0,0"
                     Foreground="{DynamicResource TextFaint}"
                     IsVisible="{Binding IsEmpty}" />
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1" Background="{DynamicResource PanelBorder}" />

      <!-- What the selected example is, and what it is for. -->
      <ScrollViewer Grid.Column="2" Padding="20,16">
        <StackPanel Spacing="10" DataContext="{Binding Selected}"
                    x:DataType="vm:ExampleCircuit">
          <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Category}" FontSize="11"
                     Foreground="{DynamicResource TextFaint}" />
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondary}" LineHeight="20" />
        </StackPanel>
      </ScrollViewer>

    </Grid>
  </DockPanel>
</Window>
