<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        x:Class="Cirq.UI.Views.DcSweepWindow"
        x:DataType="vm:DcSweepViewModel"
        Title="DC Sweep"
        Width="920" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <DockPanel>


    <!-- A way out that does not depend on a title bar, because a tiling window manager draws
         none. Escape closes it too; this is the half somebody can see. -->
    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <Button Name="CloseButton" Content="Close" MinWidth="88" Padding="14,5"
              HorizontalAlignment="Right" />
    </Border>
    <!-- What to vary. The first row is the sweep itself; the second is the optional second
         parameter that turns one curve into a family of them. -->
    <Border DockPanel.Dock="Top" Padding="14,12"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="10">

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="Sweep" VerticalAlignment="Center" Width="52" />
          <ComboBox Width="230" ItemsSource="{Binding Options}"
                    SelectedItem="{Binding Sweep, Mode=TwoWay}" />

          <TextBlock Text="from" VerticalAlignment="Center" Opacity="0.7" />
          <TextBox Width="84" Text="{Binding Start, Mode=TwoWay}" />
          <TextBlock Text="to" VerticalAlignment="Center" Opacity="0.7" />
          <TextBox Width="84" Text="{Binding Stop, Mode=TwoWay}" />

          <TextBlock Text="in" VerticalAlignment="Center" Opacity="0.7" />
          <TextBox Width="58" Text="{Binding Points, Mode=TwoWay}" />
          <TextBlock Text="points" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <CheckBox Content="Step" Width="64" IsChecked="{Binding IsStepping, Mode=TwoWay}"
                    ToolTip.Tip="Vary a second parameter as well, giving one curve per value — which is what a curve tracer does." />
          <ComboBox Width="230" ItemsSource="{Binding Options}"
                    SelectedItem="{Binding Step, Mode=TwoWay}"
                    IsEnabled="{Binding IsStepping}" />

          <TextBlock Text="from" VerticalAlignment="Center" Opacity="0.7" />
          <TextBox Width="84" Text="{Binding StepStart, Mode=TwoWay}" IsEnabled="{Binding IsStepping}" />
          <TextBlock Text="to" VerticalAlignment="Center" Opacity="0.7" />
          <TextBox Width="84" Text="{Binding StepStop, Mode=TwoWay}" IsEnabled="{Binding IsStepping}" />

          <TextBlock Text="in" VerticalAlignment="Center" Opacity="0.7" />
          <TextBox Width="58" Text="{Binding StepCount, Mode=TwoWay}" IsEnabled="{Binding IsStepping}" />
          <TextBlock Text="curves" VerticalAlignment="Center" Opacity="0.7" />

          <Button Content="Sweep" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}"
                  Padding="18,5" />
        </StackPanel>

        <!-- The same sweep, worked backwards. Every other analysis asks what the circuit does
             given these parts; this asks what part gives that answer, which is the question
             somebody actually has in front of them. -->
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="Solve" Width="52" VerticalAlignment="Center"
                     ToolTip.Tip="Find the value of the swept parameter that makes the first probe read what you want. It searches the range above." />
          <TextBlock Text="for a reading of" VerticalAlignment="Center" Opacity="0.7" />
          <TextBox Width="84" Text="{Binding TargetValue, Mode=TwoWay}" />
          <Button Content="Find the value" Command="{Binding SolveForValueCommand}" Padding="14,5" />

          <TextBlock Text="{Binding SolveResult}" VerticalAlignment="Center" FontSize="11"
                     Opacity="0.85" TextWrapping="Wrap" MaxWidth="520"
                     IsVisible="{Binding HasSolveResult}" />
        </StackPanel>

      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.85" />
    </Border>

    <sp:AvaPlot Name="Plot" />

  </DockPanel>
</Window>
