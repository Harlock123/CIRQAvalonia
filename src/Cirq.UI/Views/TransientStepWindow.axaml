<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        x:Class="Cirq.UI.Views.TransientStepWindow"
        x:DataType="vm:TransientStepViewModel"
        Title="Step a Parameter"
        Width="920" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <DockPanel>


    <!-- A way out that does not depend on a title bar, because a tiling window manager draws
         none. Escape closes it too; this is the half somebody can see. -->
    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <Button Name="CloseButton" Content="Close" MinWidth="88" Padding="14,5"
              HorizontalAlignment="Right" />
    </Border>
    <!-- One row: what to vary, over what range, in how many passes, and how long each runs. -->
    <Border DockPanel.Dock="Top" Padding="14,12"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="10">

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="Step" VerticalAlignment="Center" Width="52" />
          <ComboBox AutomationProperties.Name="What to step" Width="230" ItemsSource="{Binding Options}"
                    SelectedItem="{Binding Parameter, Mode=TwoWay}"
                    ToolTip.Tip="What to change between passes. A capacitor or an inductor is the usual choice — those decide the shape of a transient rather than its size." />

          <TextBlock Text="from" VerticalAlignment="Center" Opacity="0.7" />
          <TextBox AutomationProperties.Name="Step from" Width="96" Text="{Binding Start, Mode=TwoWay}" />
          <TextBlock Text="to" VerticalAlignment="Center" Opacity="0.7" />
          <TextBox AutomationProperties.Name="Step to" Width="96" Text="{Binding Stop, Mode=TwoWay}" />

          <TextBlock Text="in" VerticalAlignment="Center" Opacity="0.7" />
          <ComboBox AutomationProperties.Name="Number of runs" Width="70" SelectedItem="{Binding Count, Mode=TwoWay}"
                    ItemsSource="{Binding Source={x:Static vm:TransientStepViewModel.CountOptions}}" />
          <TextBlock Text="runs" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="Each for" VerticalAlignment="Center" Width="52" />
          <TextBox AutomationProperties.Name="How long to run each pass, in seconds" Width="120" Text="{Binding Duration, Mode=TwoWay}"
                   ToolTip.Tip="How long to run each pass, in seconds. Long enough to see the circuit settle — the overshoot figure in the status line is measured against where it ended up." />
          <TextBlock Text="seconds" VerticalAlignment="Center" Opacity="0.7" />

          <Button Content="Run" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}"
                  Padding="18,5" />

          <TextBlock VerticalAlignment="Center" Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                     Text="Every pass starts from the same conditions, so the curves differ only by the value." />
        </StackPanel>

      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.85" />
    </Border>

    <sp:AvaPlot Name="Plot" />

  </DockPanel>
</Window>
