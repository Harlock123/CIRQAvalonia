<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        x:Class="Cirq.UI.Views.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title="About CirqAvalonia"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <StackPanel Spacing="0">

    <!-- Header. The mark is the application's own resistor symbol, drawn from the same
         geometry SymbolRenderer uses, so the dialog is stamped with the thing it is about. -->
    <Border Background="{DynamicResource CanvasBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1"
            Padding="24,22">
      <StackPanel Orientation="Horizontal" Spacing="18">

        <Canvas Width="72" Height="40" VerticalAlignment="Center">
          <Path Stroke="{DynamicResource SymbolStroke}" StrokeThickness="2"
                StrokeLineCap="Round" StrokeJoin="Round"
                Data="M 0,20 L 12,20 L 15,12 L 21,28 L 27,12 L 33,28 L 39,12 L 45,28 L 48,20 L 60,20" />
          <Ellipse Canvas.Left="-4" Canvas.Top="16" Width="8" Height="8"
                   Fill="{DynamicResource TerminalFill}" />
          <Ellipse Canvas.Left="56" Canvas.Top="16" Width="8" Height="8"
                   Fill="{DynamicResource TerminalFill}" />
        </Canvas>

        <StackPanel Spacing="4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding ApplicationName}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <Border Background="{DynamicResource HoverBackground}" CornerRadius="4"
                    Padding="8,2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Version}" FontSize="12"
                         Foreground="{DynamicResource TextValue}" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Tagline}" FontSize="12"
                     Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
        </StackPanel>

      </StackPanel>
    </Border>

    <StackPanel Margin="24,20" Spacing="18">

      <StackPanel Spacing="3">
        <TextBlock Text="{Binding Contents}" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Runtime}" FontSize="11"
                   Foreground="{DynamicResource TextMuted}" />
        <TextBlock Text="{Binding Platform}" FontSize="11"
                   Foreground="{DynamicResource TextMuted}" />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="Built on" Classes="label" />

        <ItemsControl ItemsSource="{Binding Libraries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LibraryInfo">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,9">
                <StackPanel Grid.Column="0" Spacing="1">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding Version}" FontSize="12.5"
                               Foreground="{DynamicResource TextValue}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Purpose}" FontSize="11"
                             Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding Licence}" FontSize="10.5"
                           VerticalAlignment="Top" Margin="12,2,0,0"
                           Foreground="{DynamicResource TextFaint}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Border Height="1" Background="{DynamicResource PanelBorder}" />

      <!-- Selectable rather than a plain label: someone reading this wants to get at the
           address, and a dialog that shows a URL you cannot pick up is an annoyance. -->
      <SelectableTextBlock Text="{Binding RepositoryUrl}" FontSize="11"
                           Foreground="{DynamicResource TextMuted}"
                           ToolTip.Tip="Source, releases and the changelog" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Copy details" MinWidth="104" Name="CopyButton"
                ToolTip.Tip="Puts these versions on the clipboard, for pasting into a bug report" />
        <Button Content="Close" MinWidth="88" IsDefault="True" IsCancel="True" Name="CloseButton" />
      </StackPanel>

    </StackPanel>
  </StackPanel>
</Window>
