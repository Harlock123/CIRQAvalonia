<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        x:Class="Cirq.UI.Views.StabilityWindow"
        x:DataType="vm:StabilityViewModel"
        Title="Stability"
        Width="960" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <DockPanel>

    <Border DockPanel.Dock="Top" Padding="14,12"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Break at" VerticalAlignment="Center" />
        <ComboBox Width="150" ItemsSource="{Binding Probes}"
                  SelectedItem="{Binding Probe, Mode=TwoWay}"
                  ToolTip.Tip="Which loop probe to open. Break the loop where the impedance looking forward is much higher than the impedance looking back — an op-amp input is ideal, an op-amp output is not." />

        <TextBlock Text="from" VerticalAlignment="Center" Opacity="0.7" />
        <TextBox Width="80" Text="{Binding StartHz, Mode=TwoWay}" />
        <TextBlock Text="to" VerticalAlignment="Center" Opacity="0.7" />
        <TextBox Width="80" Text="{Binding StopHz, Mode=TwoWay}" />
        <TextBlock Text="Hz" VerticalAlignment="Center" Opacity="0.7" />

        <Button Content="Measure" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}"
                Padding="18,5" />
      </StackPanel>
    </Border>

    <!-- The three numbers the whole analysis exists to produce, said in words as well as
         figures — a phase margin is only meaningful against the thresholds, and expecting
         everybody to carry those in their head is how a plot gets misread. -->
    <Border DockPanel.Dock="Bottom" Padding="14,10"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="26">
          <StackPanel>
            <TextBlock Text="PHASE MARGIN" FontSize="10" Opacity="0.5" />
            <TextBlock Text="{Binding PhaseMargin}" FontSize="19" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="GAIN MARGIN" FontSize="10" Opacity="0.5" />
            <TextBlock Text="{Binding GainMargin}" FontSize="19" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="CROSSOVER" FontSize="10" Opacity="0.5" />
            <TextBlock Text="{Binding Crossover}" FontSize="19" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" VerticalAlignment="Center"
                     MaxWidth="470" Opacity="0.85" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.6" FontSize="11" />
          <TextBlock Text="{Binding Readout}" FontSize="11" FontFamily="monospace"
                     Foreground="{DynamicResource NetHighlight}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <sp:AvaPlot Name="Plot" />

  </DockPanel>
</Window>
