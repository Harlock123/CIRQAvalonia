<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        x:Class="Cirq.UI.Views.BusWindow"
        x:DataType="vm:BusViewModel"
        Title="Add a Bus"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <StackPanel Margin="18" Spacing="12">

    <TextBlock Text="A bus is a set of named signals — D0, D1, D2 — and the taps that join pins to them. Two taps with the same name are one net, whether or not a line is drawn between them."
               TextWrapping="Wrap" Opacity="0.8" FontSize="12" />

    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
      <TextBlock Text="Called" VerticalAlignment="Center" Width="52" />
      <TextBox Width="90" AutomationProperties.Name="What the bus is called"
               Text="{Binding Name, Mode=TwoWay}" />

      <TextBlock Text="from" VerticalAlignment="Center" Opacity="0.7" />
      <TextBox Width="60" AutomationProperties.Name="The lowest signal number"
               Text="{Binding First, Mode=TwoWay}" />

      <TextBlock Text="width" VerticalAlignment="Center" Opacity="0.7" />
      <ComboBox Width="76" AutomationProperties.Name="How many signals"
                SelectedItem="{Binding Width, Mode=TwoWay}"
                ItemsSource="{Binding Source={x:Static vm:BusViewModel.WidthOptions}}" />
    </StackPanel>

    <CheckBox Content="Draw the bus line as well" IsChecked="{Binding DrawTheLine, Mode=TwoWay}"
              AutomationProperties.Name="Draw the bus line as well"
              ToolTip.Tip="The heavy line is drawing rather than wiring — the names are what join the signals — but it is what tells a reader the taps belong together" />

    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.85" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Name="CloseButton" Content="Cancel" MinWidth="88" IsCancel="True" />
      <Button Name="PlaceButton" Content="Place" MinWidth="96" IsDefault="True" />
    </StackPanel>

  </StackPanel>
</Window>
