<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        x:Class="Cirq.UI.Views.PowerWindow"
        x:DataType="vm:PowerViewModel"
        Title="Power"
        Width="820" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <DockPanel>

    <!-- A way out that does not depend on a title bar, because a tiling window manager draws
         none. Escape closes it too; this is the half somebody can see. -->
    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <Button Name="CloseButton" Content="Close" MinWidth="88" Padding="14,5"
              HorizontalAlignment="Right" />
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="14,10"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="Average over" VerticalAlignment="Center" Opacity="0.8" FontSize="12" />
          <TextBox Text="{Binding AverageOverSeconds}" Width="88" VerticalAlignment="Center"
                   ToolTip.Tip="Seconds of running to average across. Several cycles of whatever the circuit does. Zero reads the instant instead." />
          <TextBlock Text="s" VerticalAlignment="Center" Opacity="0.8" FontSize="12" />
          <Button Content="Measure again" Command="{Binding RunCommand}" Padding="14,5" />
        </StackPanel>
        <TextBlock Text="{Binding Basis}" VerticalAlignment="Center" Opacity="0.75"
                   FontSize="11" TextWrapping="Wrap" MaxWidth="380" />
      </DockPanel>
    </Border>

    <!-- The verdict first, because it is what somebody opened the window to read. -->
    <Border DockPanel.Dock="Top" Padding="16,14,16,10">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Summary}" FontSize="14" TextWrapping="Wrap" />
        <TextBlock Text="{Binding BatteryLife}" IsVisible="{Binding HasBattery}"
                   FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <TextBlock IsVisible="{Binding IsEmpty}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Opacity="0.7" TextAlignment="Center"
               Text="Nothing here dissipates or supplies anything.&#x0a;&#x0a;A part is counted when it says what it turns into heat — a&#x0a;resistor through its power rating, a semiconductor through&#x0a;its own thermal model. A capacitor stores and returns its&#x0a;energy rather than spending it, so it has none to count." />

    <ScrollViewer IsVisible="{Binding !IsEmpty}">
      <StackPanel Margin="14,0,14,12" Spacing="14">

        <StackPanel Spacing="4">
          <TextBlock Text="Dissipating" FontSize="11" Opacity="0.6" Margin="2,0" />

          <Grid ColumnDefinitions="64,86,110,96,*" Margin="2,0,2,2">
            <TextBlock Grid.Column="0" Text="" FontSize="10" Opacity="0.5" />
            <TextBlock Grid.Column="1" Text="Part" FontSize="10" Opacity="0.5" />
            <TextBlock Grid.Column="2" Text="Dissipating" FontSize="10" Opacity="0.5" />
            <TextBlock Grid.Column="3" Text="Rated" FontSize="10" Opacity="0.5" />
            <TextBlock Grid.Column="4" Text="Die" FontSize="10" Opacity="0.5" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Parts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PowerRowViewModel">
                <Grid ColumnDefinitions="64,86,110,96,*" Margin="2,3">
                  <Border Grid.Column="0" CornerRadius="3" Padding="6,1" Height="20"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          Background="{DynamicResource GroupHeaderBackground}">
                    <TextBlock Text="{Binding Status}" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                             TextTrimming="CharacterEllipsis" Margin="0,2,8,0" />
                  <TextBlock Grid.Column="2" Text="{Binding Watts}" FontSize="12" Margin="0,2,8,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Rating}" FontSize="12" Margin="0,2,8,0" />
                  <TextBlock Grid.Column="4" Text="{Binding Die}" FontSize="12" Margin="0,2,0,0"
                             Opacity="0.85" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding HasSupplies}">
          <TextBlock Text="Supplying" FontSize="11" Opacity="0.6" Margin="2,0" />

          <Grid ColumnDefinitions="86,110,96,*" Margin="2,0,2,2">
            <TextBlock Grid.Column="0" Text="Part" FontSize="10" Opacity="0.5" />
            <TextBlock Grid.Column="1" Text="Holding" FontSize="10" Opacity="0.5" />
            <TextBlock Grid.Column="2" Text="Delivering" FontSize="10" Opacity="0.5" />
            <TextBlock Grid.Column="3" Text="Power" FontSize="10" Opacity="0.5" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Supplies}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SupplyRowViewModel">
                <Grid ColumnDefinitions="86,110,96,*" Margin="2,3">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Volts}" FontSize="12" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="2" Text="{Binding Amps}" FontSize="12" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Watts}" FontSize="12" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
