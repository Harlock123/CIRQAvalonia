<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
        x:Class="Cirq.UI.Views.SpectrumAnalyserWindow"
        x:DataType="vm:SpectrumViewModel"
        Title="Spectrum"
        Width="900" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackground}">

  <DockPanel>


    <!-- A way out that does not depend on a title bar, because a tiling window manager draws
         none. Escape closes it too; this is the half somebody can see. -->
    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <Button Name="CloseButton" Content="Close" MinWidth="88" Padding="14,5"
              HorizontalAlignment="Right" />
    </Border>
    <Border DockPanel.Dock="Top" Padding="14,12"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Window" VerticalAlignment="Center" />
          <ComboBox AutomationProperties.Name="Window function" Width="150" SelectedItem="{Binding Window, Mode=TwoWay}"
                    ItemsSource="{Binding Source={x:Static vm:SpectrumViewModel.WindowOptions}}"
                    ToolTip.Tip="How the block is tapered before transforming. Hann is the general-purpose choice; Blackman-Harris picks a small component out from beside a large one; Rectangular is right only when the block holds a whole number of cycles." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Points" VerticalAlignment="Center" />
          <ComboBox AutomationProperties.Name="Transform size" Width="90" SelectedItem="{Binding Size, Mode=TwoWay}"
                    ItemsSource="{Binding Source={x:Static vm:SpectrumViewModel.SizeOptions}}"
                    ToolTip.Tip="More points is finer resolution over a longer stretch of signal; fewer follows a changing signal more closely." />
        </StackPanel>

        <CheckBox Content="Decibels" IsChecked="{Binding IsLogarithmic}" VerticalAlignment="Center"
                  ToolTip.Tip="A harmonic at a hundredth of the fundamental is invisible on a linear axis and obvious on a log one." />

        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Harmonics" VerticalAlignment="Center" />
          <ComboBox AutomationProperties.Name="Harmonics to measure" Width="70" SelectedItem="{Binding HarmonicCount, Mode=TwoWay}"
                    ItemsSource="{Binding Source={x:Static vm:SpectrumViewModel.HarmonicCountOptions}}"
                    ToolTip.Tip="How many multiples of the fundamental to measure. Past the ninth they are usually below the floor, and on anything but a low fundamental they have run past the Nyquist limit anyway." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Fundamental" VerticalAlignment="Center" />
          <TextBox AutomationProperties.Name="Fundamental frequency, in hertz" Width="90" Text="{Binding FundamentalHz, Mode=TwoWay}"
                   PlaceholderText="auto" MinHeight="0" Padding="6,3"
                   ToolTip.Tip="The frequency to measure distortion against, in hertz. Leave at 0 to take the largest component — but state it when you know it: at heavy distortion a harmonic can be the biggest thing in the spectrum, and then the automatic answer is about a different question." />
        </StackPanel>

        <Button Content="Transform" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}"
                Padding="18,5" />
      </StackPanel>
    </Border>

    <!-- Distortion. The spectrum shows the harmonics; this says how much of them there is, which
         is the number an amplifier is actually sold on and the one thing here that cannot be
         read off the plot by eye. -->
    <Border DockPanel.Dock="Bottom" Padding="14,8" IsVisible="{Binding HasDistortion}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <StackPanel Spacing="6">
        <TextBlock Text="DISTORTION" Classes="heading" />

        <ItemsControl ItemsSource="{Binding Distortion}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DistortionRow">
              <Grid ColumnDefinitions="110,110,90,90,*" Margin="0,2">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.85"
                           Text="{Binding Fundamental}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Text="{Binding Thd}" ToolTip.Tip="Total harmonic distortion: the harmonics added in quadrature, over the fundamental." />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Opacity="0.75"
                           Text="{Binding ThdPlusNoise}" ToolTip.Tip="THD+N: everything that is not the fundamental — harmonics, noise, hum, intermodulation. Always the larger of the two." />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Opacity="0.65"
                           Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="110,110,90,90,*">
          <TextBlock Grid.Column="1" Text="fundamental" FontSize="10" Opacity="0.5" />
          <TextBlock Grid.Column="2" Text="THD" FontSize="10" Opacity="0.5" />
          <TextBlock Grid.Column="3" Text="THD+N" FontSize="10" Opacity="0.5" />
          <TextBlock Grid.Column="4" Text="largest harmonics, relative to the carrier" FontSize="10" Opacity="0.5" />
        </Grid>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="14,9"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.85" />
    </Border>

    <sp:AvaPlot Name="Plot" />

  </DockPanel>
</Window>
