<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Cirq.UI.ViewModels"
             x:Class="Cirq.UI.App"
>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Cirq.UI/Views/Themes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Cirq.UI/Views/Styles.axaml" />
  </Application.Styles>

  <!-- Implicit templates: the inspector builds a heterogeneous list of parameter view models
       and each one renders itself according to its type. -->
  <Application.DataTemplates>

    <DataTemplate DataType="vm:NumericParameterViewModel">
      <Grid ColumnDefinitions="118,*" Margin="10,3">
        <TextBlock Classes="label" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Label}" />
        <TextBox Grid.Column="1" Classes="parameter" Text="{Binding Text}"
                 Classes.error="{Binding HasError}"
                 ToolTip.Tip="Accepts engineering notation: 4k7, 100n, 2.2M, 10kOhm" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:BooleanParameterViewModel">
      <Grid ColumnDefinitions="118,*" Margin="10,3">
        <TextBlock Classes="label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        <!-- The mode is explicit. Left implicit, the freshly realised toggle pushed its own
             default back into the source before it read from it, silently clearing the property
             it was supposed to be showing. -->
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Value, Mode=TwoWay}"
                      OnContent="" OffContent="" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:OptionParameterViewModel">
      <Grid ColumnDefinitions="118,*" Margin="10,3">
        <TextBlock Classes="label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="12"
                  ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" />
      </Grid>
    </DataTemplate>

    <!-- Live controls. A switch is a toggle and a range is a slider; the label carries the
         designator so a panel of eight of them says which part each one belongs to. -->
    <DataTemplate DataType="vm:ToggleControlViewModel">
      <Grid ColumnDefinitions="*,Auto" Margin="10,4">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Subtitle}" FontSize="10"
                     Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Value, Mode=TwoWay}"
                      OnContent="" OffContent="" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:SliderControlViewModel">
      <StackPanel Margin="10,4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="12"
                     Foreground="{DynamicResource TextValue}" />
        </Grid>
        <Slider Minimum="0" Maximum="1" Value="{Binding Position}" Margin="0,-2,0,-6" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:TextParameterViewModel">
      <Grid ColumnDefinitions="118,*" Margin="10,3">
        <TextBlock Classes="label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        <TextBox Grid.Column="1" Classes="parameter" Text="{Binding Value}" />
      </Grid>
    </DataTemplate>

  </Application.DataTemplates>
</Application>
