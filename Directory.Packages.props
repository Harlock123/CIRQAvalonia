<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AvaloniaVersion>12.1.2</AvaloniaVersion>
  </PropertyGroup>
  <!-- Avalonia 12 and ScottPlot 5.1.x both build on SkiaSharp 3.119. Pairing Avalonia 11
       (SkiaSharp 2.88) with ScottPlot 5.1.x loads a managed SkiaSharp 3.x against a native
       libSkiaSharp 2.88 and fails at startup, so these two versions move together. -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
        <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="ScottPlot.Avalonia" Version="5.1.59" />
    <!-- Drives real windows in tests without a display: the suite can open a dialog, press its
         button and assert what happened. Pinned to $(AvaloniaVersion) like the rest of Avalonia,
         because a headless platform and the framework it stands in for have to be the same one.
         The base package rather than Avalonia.Headless.XUnit, which from 12.0 depends on xunit v3
         and would collide with the v2 the rest of this suite is written against — the session is
         driven by hand instead, which is a dozen lines. -->
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <!-- Already in the tree underneath Avalonia and ScottPlot; referenced explicitly because the
         exporter draws on it directly, and pinned to the version both of those agree on. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.0" />
    <!-- Markdown to HTML for the printable guide, used only by tools/Cirq.Docs. BSD-2-Clause,
         no transitive dependencies on net10.0, and nothing the application ships references it. -->
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>
</Project>
