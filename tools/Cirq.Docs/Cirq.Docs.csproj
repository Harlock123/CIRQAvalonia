<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cirq.Docs</RootNamespace>
    <!-- A build tool, not part of the product. It is never published with the application and
         nothing in src/ references it, so its one dependency cannot reach the shipped binaries. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
  </ItemGroup>

</Project>
